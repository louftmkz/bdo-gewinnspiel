# Password for the /admin edit mode
ADMIN_PASSWORD=

# Random long secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token, "Contents: Read and write" on this repo only.
# Used at runtime by /admin (save) and the spin endpoint to commit raffle
# data straight to this repo, which then triggers a Vercel redeploy.
GITHUB_TOKEN=
GITHUB_REPO=louftmkz/bdo-gewinnspiel
GITHUB_BRANCH=main
